<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>StillCodexSwitcher</AssemblyName><RootNamespace>Still.Windows</RootNamespace>
    <RuntimeFrameworkVersion>8.0.32</RuntimeFrameworkVersion>
    <Version>1.0.0</Version><Company>Still Local Tools</Company><Product>栖言 Codex 账号</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Core/Still.Core.csproj" /><Compile Include="../Tests/TestSuite.cs" Link="TestSuite.cs" /></ItemGroup>
</Project>

<Window x:Class="Still.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="栖言 · Codex 账号" Width="1100" Height="820" MinWidth="940" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
<Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
  <Grid Margin="20,26,20,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,35">
    <Border Background="{DynamicResource ButtonBrush}" Width="37" Height="37" CornerRadius="12" Margin="0,0,11,0"><Canvas Width="37" Height="37"><Rectangle Width="6" Height="19" RadiusX="3" RadiusY="3" Fill="{DynamicResource ButtonTextBrush}" Canvas.Left="10" Canvas.Top="9"><Rectangle.RenderTransform><RotateTransform Angle="25" CenterX="3" CenterY="9"/></Rectangle.RenderTransform></Rectangle><Rectangle Width="6" Height="13" RadiusX="3" RadiusY="3" Fill="{DynamicResource ButtonTextBrush}" Opacity="0.65" Canvas.Left="22" Canvas.Top="9"><Rectangle.RenderTransform><RotateTransform Angle="25" CenterX="3" CenterY="6"/></Rectangle.RenderTransform></Rectangle></Canvas></Border>
    <StackPanel><TextBlock Text="栖言" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="CODEX ACCOUNT SWITCHER" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
   </StackPanel>
   <StackPanel Grid.Row="1"><TextBlock Text="你的工作，从容接续" Style="{StaticResource Muted}" Margin="2,0,0,12" FontSize="10"/>
    <Button x:Name="AccountsNav" Style="{StaticResource Nav}" Background="{DynamicResource WashBrush}" Click="ShowAccounts"><Grid Width="150"><TextBlock Text="账号空间" FontWeight="SemiBold"/><TextBlock x:Name="SidebarCount" Text="0" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid></Button>
    <Button x:Name="SettingsNav" Content="偏好与说明" Style="{StaticResource Nav}" Click="ShowSettings"/>
   </StackPanel>
   <StackPanel Grid.Row="3">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="16" Margin="0,0,0,18"><StackPanel>
     <TextBlock Text="◇" Foreground="{DynamicResource AccentBrush}" FontSize="24" Margin="0,0,0,10"/>
     <TextBlock Text="留在本机，随时就位。" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="Windows 用户级加密。&#10;不保存密码。额度查询仅连接官方服务。" Style="{StaticResource Muted}" FontSize="10.5"/>
    </StackPanel></Border>
    <TextBlock x:Name="ModeLabel" Text="●  本地账号管理                 1.1" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
   </StackPanel>
  </Grid>
 </Border>
 <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="32,18,32,12"><Button Content="打开 Codex ↗" DockPanel.Dock="Right" Click="OpenCodex" Padding="10,6" Background="Transparent" BorderThickness="0"/><TextBlock x:Name="Breadcrumb" Text="工作台   /   账号空间" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
  <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid Margin="32,15,32,25">
    <StackPanel x:Name="AccountsPage">
     <TextBlock Text="ONE CLICK. ANOTHER PERSPECTIVE." FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
     <TextBlock Text="账号就位，一键接续。" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,9"/>
     <TextBlock Text="保存你的 Codex 登录状态。换个账号，不必重新来过。" Style="{StaticResource Muted}" Margin="0,0,0,24"/>
     <Border Style="{StaticResource Card}"><StackPanel>
      <DockPanel Margin="0,0,0,18"><TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" Text="CODEX · WINDOWS" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="●  当前本机配置" FontSize="11" Foreground="{DynamicResource AccentBrush}"/></DockPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource WashBrush}" Margin="0,0,14,0"><TextBlock Text="›_" FontFamily="Consolas" FontSize="25" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="CurrentName" Text="先让一个账号就位" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="CurrentEmail" Text="在 Codex 登录后保存，或通过下方添加账号。" Style="{StaticResource Muted}" Margin="0,6,12,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
       <Button x:Name="SaveButton" Grid.Column="2" Content="保存当前账号" Style="{StaticResource Primary}" Click="SaveCurrent" VerticalAlignment="Center"/>
      </Grid>
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,19,0,0" Padding="0,12,0,0"><DockPanel><Button Content="↻" Click="RefreshClick" DockPanel.Dock="Right" ToolTip="刷新本机登录状态" Padding="8,1" BorderThickness="0"/><TextBlock Text="独立保存 · 切换前备份 · 支持回滚" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></DockPanel></Border>
     </StackPanel></Border>
     <DockPanel Margin="0,25,0,15"><Button x:Name="AddButton" Content="＋ 添加账号" DockPanel.Dock="Right" Click="AddAccount"/><TextBox x:Name="SearchBox" Width="155" DockPanel.Dock="Right" Margin="0,0,12,0" ToolTip="按备注或邮箱搜索" TextChanged="SearchChanged"/><TextBlock Text="已保存账号" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/></DockPanel>
     <DockPanel Margin="0,0,0,12"><Button x:Name="QuotaRefreshButton" Content="↻ 刷新全部额度" DockPanel.Dock="Right" Click="RefreshAllQuotas" Padding="10,6" FontSize="11"/><Button x:Name="CancelQuotaButton" Content="停止" DockPanel.Dock="Right" Click="CancelQuotas" Visibility="Collapsed" Padding="10,6" Margin="0,0,8,0"/><TextBlock Text="剩余额度 · 每 5 分钟刷新 · 不切换账号" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
     <Border x:Name="EmptyState" CornerRadius="14" Background="{DynamicResource SidebarBrush}" Padding="27" Margin="0,0,0,12"><StackPanel><TextBlock Text="从你正在使用的账号开始" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="点击上方「保存当前账号」，再添加其他账号。&#10;每个账号首次登录一次，之后点选切换。" Style="{StaticResource Muted}"/></StackPanel></Border>
     <TextBlock x:Name="NoMatches" Text="没有匹配的账号" Style="{StaticResource Muted}" Margin="0,15" Visibility="Collapsed"/>
     <ItemsControl x:Name="AccountsList"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="13" Padding="16,14" Margin="0,0,0,10">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="44" Height="44" Background="{Binding AvatarBackground}" CornerRadius="12" Margin="0,0,13,0"><TextBlock Text="{Binding Initial}" Foreground="{Binding AvatarColor}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" MaxWidth="210" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Background="{DynamicResource SidebarBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"><TextBlock Text="{Binding Plan}" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource MutedBrush}"/></Border></StackPanel><TextBlock Text="{Binding Email}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,5,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
        <Button Grid.Column="2" Content="{Binding SwitchText}" Tag="{Binding Account}" IsEnabled="{Binding CanSwitch}" Click="SwitchAccount" VerticalAlignment="Center" FontSize="11" Padding="13,9"/>
        <Button Grid.Column="3" Content="•••" Tag="{Binding Account}" Click="AccountMenu" Margin="8,0,0,0" VerticalAlignment="Center" Padding="7,8" BorderThickness="0" ToolTip="账号操作"/>
        <Border Grid.Row="1" Grid.ColumnSpan="4" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0"><StackPanel>
         <Grid Opacity="{Binding QuotaOpacity}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><DockPanel><TextBlock Text="{Binding FivePercent}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{Binding FiveColor}"/><TextBlock Text="5 小时剩余" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></DockPanel><ProgressBar Value="{Binding FiveValue, Mode=OneWay}" Maximum="100" Height="5" Margin="0,7,0,6" Foreground="{Binding FiveColor}" Background="{DynamicResource WashBrush}" BorderThickness="0"/><TextBlock Text="{Binding FiveReset}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
          <StackPanel Grid.Column="2"><DockPanel><TextBlock Text="{Binding SevenPercent}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{Binding SevenColor}"/><TextBlock Text="7 天剩余" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></DockPanel><ProgressBar Value="{Binding SevenValue, Mode=OneWay}" Maximum="100" Height="5" Margin="0,7,0,6" Foreground="{Binding SevenColor}" Background="{DynamicResource WashBrush}" BorderThickness="0"/><TextBlock Text="{Binding SevenReset}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
         </Grid>
         <DockPanel Margin="0,8,0,0"><Button Content="刷新" DockPanel.Dock="Right" Tag="{Binding Account}" Click="RefreshAccountQuota" IsEnabled="{Binding CanRefresh}" Padding="8,2" FontSize="10" BorderThickness="0" Background="Transparent"/><TextBlock Text="{Binding QuotaStatus}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
        </StackPanel></Border>
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="ⓘ  切换会重新打开 Codex。请先保存任务，并结束其他共享登录的 Codex CLI 会话。" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
     <TextBlock Text="MAKE YOURSELF AT HOME." FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
     <TextBlock Text="舒服一点，简单一点。" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,9"/>
     <TextBlock Text="这是 Codex 的账号管理工具，不是另一个聊天客户端。" Style="{StaticResource Muted}" Margin="0,0,0,23"/>
     <Border Style="{StaticResource Card}" Margin="0,0,0,15"><StackPanel><TextBlock Text="外观" FontWeight="SemiBold" Margin="0,0,0,15"/><StackPanel Orientation="Horizontal"><Button Content="跟随系统" Tag="system" Click="ThemeClick" Margin="0,0,8,0"/><Button Content="浅色" Tag="light" Click="ThemeClick" Margin="0,0,8,0"/><Button Content="深色" Tag="dark" Click="ThemeClick"/></StackPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,15"><StackPanel><TextBlock Text="连接你的 Codex" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="DesktopPathLabel" Style="{StaticResource Muted}" Text="正在检测安装位置…"/><TextBlock x:Name="CliPathLabel" Style="{StaticResource Muted}" Margin="0,7,0,14"/>
      <WrapPanel><Button Content="重新检测" Click="DetectClick" Margin="0,0,8,0"/><Button Content="选择 Codex 程序" Click="ChooseDesktop" Margin="0,0,8,0"/><Button Content="选择官方 CLI" Click="ChooseCli"/></WrapPanel>
      <TextBlock Text="支持自动检测当前运行的 Codex、常见安装位置和 Microsoft Store 安装。未识别时可手动选择官方程序。" Style="{StaticResource Muted}" FontSize="11" Margin="0,13,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,15"><StackPanel><TextBlock Text="登录资料只留在本机" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="保存的凭据和回滚备份由 Windows DPAPI 当前用户加密，文件只对当前用户和系统开放。密码始终在官方登录页面输入。&#10;&#10;Codex 使用中的 auth.json 仍由 Codex 管理。适配 ChatGPT 登录与 file 存储模式，不修改聊天记录、订阅或项目。订阅标签来自缓存。额度由独立官方 CLI 查询，不触碰当前登录文件、不使用刷新令牌；仅在内存保留结果。过期登录需更新备份或重新添加。" Style="{StaticResource Muted}"/><TextBlock x:Name="HomeLabel" Style="{StaticResource Muted}" Margin="0,12,0,0" FontSize="10"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="恢复与兼容性" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="首次切换后，请在 Codex 头像里核对账号。登录过期或被撤销时，需要重新添加。Windows 与 WSL 的登录目录分别管理；本工具只切换 Windows 本机 Codex。" Style="{StaticResource Muted}" Margin="0,0,0,15"/><Button Content="恢复上次切换前的账号" Click="RestoreAccount" HorizontalAlignment="Left"/></StackPanel></Border>
     <TextBlock Text="独立第三方工具 · Windows 10/11 x64 · 无需管理员权限" Style="{StaticResource Muted}" FontSize="10" Margin="0,15,0,0"/>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" Padding="23,12"><DockPanel><Button x:Name="CancelLoginButton" Content="取消登录" DockPanel.Dock="Right" Click="CancelLogin" Visibility="Collapsed" Padding="10,4"/><TextBlock x:Name="StatusText" Text="准备就绪。首次使用请保存当前账号。" Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>
</Grid>
</Window>
